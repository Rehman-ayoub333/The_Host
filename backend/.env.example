GEMINI_API_KEY=your_key_here
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Sulafat
OPERATOR_TOKEN=choose_a_long_random_string
AGENT_NAME=THE HOST
STALL_NAME=Bite & Pour
MENU_JSON_PATH=./data/menu.json
BUSINESS_INFO_JSON_PATH=./data/business_info.json
DB_PATH=./data/the_host.db
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:4173
PORT=8000
VISION_SEND_MODE=client_content
# 16 section 2zi item 4(a): the guests' feedback form, hosted on Netlify. With
# these two left blank the import is simply off and the dashboard says so.
# NETLIFY_TOKEN is a Netlify personal access token (User settings ->
# Applications -> Personal access tokens); NETLIFY_SITE_ID is the site's API ID
# (Site configuration -> General -> Site information).
NETLIFY_TOKEN=your_netlify_personal_access_token
NETLIFY_SITE_ID=your_netlify_site_api_id
NETLIFY_FORM_NAME=feedback
